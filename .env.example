# Neon database — pooled connection string from Neon console > Connection Details > Pooled
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Neon Auth — from Neon console > Auth tab > Configuration
NEON_AUTH_BASE_URL=https://your-project-id.neon.tech/auth
NEON_AUTH_COOKIE_SECRET=your-32-plus-character-random-secret

# Generate cookie secret:  openssl rand -base64 32
